<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/25.0.2 Chrome/128.0.6613.186 Electron/32.2.5 Safari/537.36" version="25.0.2">
  <diagram id="async-contour" name="Асинхронный контур АБС">
    <mxGraphModel dx="4572" dy="2596" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n_bank" value="Банк-клиент&#xa;Idempotency-Key: request_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="650" y="-370" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_gw" value="API Gateway&#xa;auth · rate-limit · tenant_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="650" y="-160" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g_facade" value="Асинхронный фасад" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="80" y="80" width="760" height="1040" as="geometry" />
        </mxCell>
        <mxCell id="n_api" value="Operations API&#xa;POST /async/operations&#xa;GET /{request_id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="130" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_rcon" value="Result Consumer&#xa;consume async-results&#xa;UPDATE WHERE TASK_PUBLISHED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="610" y="520" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_db" value="async_operations&#xa;PK: tenant_id + request_id&#xa;ACCEPTED → TASK_PUBLISHED →&#xa;COMPLETED/FAILED → NOTIFIED" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="340" y="290" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_relay" value="Task Relay&#xa;poll ACCEPTED → publish&#xa;FOR UPDATE SKIP LOCKED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="650" y="300" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_whs" value="Webhook Sender (фоновый)&#xa;poll COMPLETED/FAILED&#xa;HTTPS + HMAC + event_id&#xa;ретраи → DLQ · успех → NOTIFIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="340" y="620" width="190" height="120" as="geometry" />
