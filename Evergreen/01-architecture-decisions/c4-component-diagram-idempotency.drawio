        <mxCell id="g_services" value="Сервисы (синхронные REST) — inbox по message_id" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fontSize=14;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="2210" y="20" width="290" height="640" as="geometry" />
