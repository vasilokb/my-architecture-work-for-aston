@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма - Облачная АБС (SaaS) для банков

' === ЛЮДИ ===
Person(клиент_физ, "Клиент (Физ. лицо)", "Физическое лицо, использующее банковские услуги")
Person(клиент_юр, "Клиент (Юр. лицо)", "Юридическое лицо или ИП")
Person(сотрудник, "Сотрудник банка", "Операционист, бухгалтер, кредитный инспектор")
Person(админ_платформы, "Администратор платформы", "Управление тенантами, мониторинг, биллинг")

' === ФРОНТАЛЬНЫЕ СИСТЕМЫ (ВНЕШНИЕ ПО ОТНОШЕНИЮ К АБС) ===
System_Ext(дбо_физ, "ДБО Физ. лиц", "Веб-банк, мобильное приложение для физических лиц")
System_Ext(дбо_юр, "ДБО Юр. лиц", "Система ДБО для юридических лиц")
System_Ext(арм_сотрудника, "АРМ Сотрудника", "Рабочее место сотрудника банка")

' === НАША СИСТЕМА (SaaS ЯДРО) ===
System(абс, "Облачная АБС (SaaS)", "Ядро банковской автоматизации: бухучет, РКО, кредитный конвейер, отчетность. Предоставляет публичное API")

' === НАДСТРОЙКИ (КЛИЕНТСКИЕ РАСШИРЕНИЯ) ===
System_Ext(надстройки, "Надстройки и кастомизации", "Специфические модули, интеграции и расширения, разработанные банком или вендором поверх API АБС")

' === ВНЕШНИЕ СИСТЕМЫ (ПРЯМЫЕ ИНТЕГРАЦИИ) ===
System_Ext(процессинг, "Платежная инфраструктура", "Карточный процессинг, эквайринг, управление банкоматами")
System_Ext(сбп, "СБП", "Система быстрых платежей ЦБ РФ")
System_Ext(межбанк, "Межбанковские расчеты", "ЦБ РФ (БЭСП/МЭР), банки-корреспонденты, SWIFT")
System_Ext(цб_рф, "ЦБ РФ (Регулятор)", "Центральный банк РФ — получение нормативов, сдача отчетности")
System_Ext(кредитные_бюро, "Кредитные бюро", "Бюро кредитных историй")

' === СВЯЗИ (ЛЮДИ → ФРОНТЫ) ===
Rel(клиент_физ, дбо_физ, "Использует")
Rel(клиент_юр, дбо_юр, "Использует")
Rel(сотрудник, арм_сотрудника, "Работает")

' === СВЯЗИ (АДМИНИСТРАТОР ПЛАТФОРМЫ) ===
Rel(админ_платформы, абс, "Управляет тенантами, настраивает лимиты, мониторит", "Административный API")

' === СВЯЗИ (ФРОНТЫ → АБС) ===
Rel(дбо_физ, абс, "Управление счетами, переводы, выписки", "REST API")
Rel(дбо_юр, абс, "Платежные поручения, зарплатные проекты, валютный контроль", "REST API")
Rel(арм_сотрудника, абс, "Операционный день, андеррайтинг, комплаенс, отчетность", "REST API")

' === СВЯЗИ (НАДСТРОЙКИ → АБС) ===
Rel(надстройки, абс, "Кастомная бизнес-логика, расширения, интеграции", "REST API / Webhooks")

' === СВЯЗИ (АБС → ВНЕШНИЕ СИСТЕМЫ) ===
Rel(абс, процессинг, "Выгрузка лимитов, стоп-листов, получение транзакций для учета", "API/File")
Rel(абс, сбп, "Исходящие/входящие переводы по номеру телефона", "API")
Rel(абс, межбанк, "Межбанковские переводы (крупные, международные, корреспондентские)", "API/File/SWIFT")
Rel(абс, цб_рф, "Пруденциальная отчетность, обязательные нормативы, ОВК", "API/File")
Rel(абс, кредитные_бюро, "Запрос и передача кредитных историй", "API")

@enduml