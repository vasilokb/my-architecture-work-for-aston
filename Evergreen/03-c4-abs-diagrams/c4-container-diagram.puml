@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Контейнерная диаграмма - Облачная АБС (SaaS)
LAYOUT_TOP_DOWN()
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 40
skinparam backgroundColor transparent

' === СИСТЕМА ===
System_Boundary(абс, "Облачная АБС (SaaS)") {

    ' === 1. ВХОДЯЩИЙ ШЛЮЗ ===
    Boundary(вход, "Входящий шлюз") {
        Container(api_gateway, "API Gateway", "", "Входящая маршрутизация, аутентификация, rate limiting")
    }

    ' === 2. ЯДРО БАНКОВСКОЙ ЛОГИКИ ===
    Boundary(ядро, "Ядро банковской логики") {
        Container(клиентский_модуль, "Модуль учета клиентов (CIF)", "", "Управление клиентами, документами, классификация")
        Container(счетный_модуль, "Модуль учета счетов", "", "Управление счетами, план счетов, остатки")
        Container(бухгалтерский_модуль, "Бухгалтерский модуль", "", "Проводки, транзакции, холды, конверсии")
    }

    ' === 3. СИСТЕМА РАСЧЕТОВ ===
    Boundary(расчеты, "Система расчетов") {
        Container(платежный_модуль, "Модуль расчетов", "", "Обработка платежных документов, маршрутизация")
    }

    ' === 4. ТАРИФНЫЙ БЛОК ===
    Boundary(тарифный_блок, "Тарифный блок") {
        Container(тарифный_модуль, "Тарифный модуль", "", "Управление тарифами, расчет комиссий, тарифные пакеты")
        Container(доходы_будущих_периодов, "Модуль учета доходов будущих периодов", "", "Учет авансовых платежей, распределение дохода по периодам")
    }

    ' === 5. КАРТОЧНЫЙ БЛОК ===
    Boundary(карточный_блок, "Карточный блок") {
        Container(карточный_модуль, "Модуль пластиковых карт", "", "Управление картами, эмбоссинг, пин-коды, карточные продукты")

    }
    ' === 5. ЛИМИТНЫЙ БЛОК ===
    Boundary(лимитный_блок, "Лимитный блок") {
        Container(лимитный_модуль, "Модуль лимитов", "", "Управление лимитами, контроль, стоп-листы")
    }
    ' === 6. КРЕДИТНЫЙ БЛОК ===
    Boundary(кредитный_блок, "Кредитный блок") {
        Container(кредитный_модуль, "Кредитный учет", "", "Учет процентов, штрафов, кредитных лимитов, связь с кредитными картами")
    }

    ' === 7. ДЕПОЗИТНЫЙ БЛОК ===
    Boundary(депозитный, "Депозитный блок") {
        Container(депозитный_модуль, "Депозитный учет", "", "Учет депозитных договоров, начисление процентов, капитализация") #red
    }

    ' === 8. АДМИНИСТРИРОВАНИЕ ===
    Boundary(администрирование, "Администрирование") {
        Container(админ_модуль, "Административный модуль", "", "Управление тенантами, пользователями, ролями, биллинг")
    }

    ' === 9. ИНТЕГРАЦИОННЫЙ СЛОЙ ===
    Boundary(интеграция, "Интеграционный слой") {
        Container(интеграционный_модуль, "Интеграционный модуль", "", "Адаптеры для внешних систем, протоколы, очереди")
    }
}

' === ВНЕШНИЕ СИСТЕМЫ ===
System_Ext(дбо_физ, "ДБО Физ. лиц", "Веб-банк, мобильное приложение")
System_Ext(дбо_юр, "ДБО Юр. лиц", "Система ДБО для юридических лиц")
System_Ext(арм_сотрудника, "АРМ Сотрудника", "Рабочее место сотрудника")

' === НАДСТРОЙКИ ===
System_Ext(кредитный_конвейер, "Кредитный конвейер", "Надстройка: андеррайтинг, скоринг, принятие решений")
System_Ext(прочие_надстройки, "Прочие надстройки", "Специфические модули, интеграции, расширения")

' === ВНЕШНИЕ СИСТЕМЫ ===
System_Ext(процессинг, "Платежная инфраструктура (Процессинг)", "Карточный процессинг, эквайринг, авторизация")
System_Ext(сбп, "СБП", "Система быстрых платежей ЦБ РФ")
System_Ext(межбанк, "Межбанковские расчеты", "ЦБ РФ, банки-корреспонденты, SWIFT")
System_Ext(цб_рф, "ЦБ РФ (Регулятор)", "Центральный банк РФ")
System_Ext(кредитные_бюро, "Кредитные бюро", "Бюро кредитных историй")

' === ВХОДЯЩИЕ СВЯЗИ (ВНЕШНИЕ → API GATEWAY) ===
Rel(дбо_физ, api_gateway, "REST API", "HTTPS")
Rel(дбо_юр, api_gateway, "REST API", "HTTPS")
Rel(арм_сотрудника, api_gateway, "REST API", "HTTPS")
Rel(кредитный_конвейер, api_gateway, "Запросы на выдачу, графики платежей", "REST API")
Rel(прочие_надстройки, api_gateway, "Кастомная бизнес-логика", "REST API / Webhooks")

' === ДВУСТОРОННЯЯ СВЯЗЬ С ПРОЦЕССИНГОМ ===
Rel(интеграционный_модуль, процессинг, "Лимиты, стоп-листы, карты / Транзакции, клиринговые файлы", "ISO8583 / API / файлы (двусторонний)")

' === ОСТАЛЬНЫЕ ВНЕШНИЕ СИСТЕМЫ ===
Rel(интеграционный_модуль, сбп, "Переводы по СБП", "HTTPS (двусторонний)")
Rel(интеграционный_модуль, межбанк, "Межбанковские переводы", "HTTPS/SFTP/SWIFT (двусторонний)")
Rel(интеграционный_модуль, цб_рф, "Отчетность", "HTTPS/SFTP")
Rel(интеграционный_модуль, кредитные_бюро, "Запросы кредитных историй", "HTTPS (двусторонний)")

' === API GATEWAY → БИЗНЕС-МОДУЛИ ===
Rel(api_gateway, клиентский_модуль, "", "REST API")
Rel(api_gateway, счетный_модуль, "", "REST API")
Rel(api_gateway, бухгалтерский_модуль, "", "REST API")
Rel(api_gateway, платежный_модуль, "", "REST API")
Rel(api_gateway, тарифный_модуль, "", "REST API")
Rel(api_gateway, доходы_будущих_периодов, "", "REST API")
Rel(api_gateway, карточный_модуль, "", "REST API")
Rel(api_gateway, кредитный_модуль, "", "REST API")
Rel(api_gateway, лимитный_модуль, "", "REST API")
Rel(api_gateway, депозитный_модуль, "", "REST API")
Rel(api_gateway, админ_модуль, "", "REST API")

' === СВЯЗИ ВНУТРИ ЯДРА ===
Rel(клиентский_модуль, счетный_модуль, "Проверка клиента при открытии счета", "REST API")
Rel(счетный_модуль, бухгалтерский_модуль, "Создание проводок по операциям", "REST API")

' === СВЯЗИ СИСТЕМЫ РАСЧЕТОВ ===
Rel(платежный_модуль, бухгалтерский_модуль, "Создание проводок для платежей", "REST API")
Rel(платежный_модуль, счетный_модуль, "Проверка остатков, блокировка средств", "REST API")
Rel(платежный_модуль, лимитный_модуль, "Проверка платежных лимитов", "REST API")
Rel(платежный_модуль, тарифный_модуль, "Расчет комиссии за платеж", "REST API")
Rel(платежный_модуль, интеграционный_модуль, "Исходящие платежи (СБП, межбанк)", "REST API")

' === СВЯЗИ ТАРИФНОГО БЛОКА ===
Rel(тарифный_модуль, счетный_модуль, "Списание комиссий", "REST API")
Rel(тарифный_модуль, бухгалтерский_модуль, "Передача проводок по комиссиям", "REST API")
Rel(тарифный_модуль, доходы_будущих_периодов, "Передача авансовых платежей", "REST API")
Rel(доходы_будущих_периодов, бухгалтерский_модуль, "Формирование проводок по признанию дохода", "REST API")
Rel(доходы_будущих_периодов, счетный_модуль, "Списание авансовых платежей", "REST API")

' === СВЯЗИ КАРТОЧНОГО БЛОКА ===
Rel(карточный_модуль, счетный_модуль, "Привязка карт к счету", "REST API")
Rel(карточный_модуль, лимитный_модуль, "Проверка/установка лимитов по карте", "REST API")
Rel(карточный_модуль, бухгалтерский_модуль, "Проводки по карточным операциям", "REST API")
Rel(карточный_модуль, тарифный_модуль, "Расчет комиссий по картам", "REST API")
Rel(карточный_модуль, интеграционный_модуль, "Выгрузка карт / Обновление статусов", "REST API (двусторонний)")

' === СВЯЗИ КРЕДИТНОГО БЛОКА ===
Rel(кредитный_модуль, карточный_модуль, "Управление кредитными картами / Запрос кредитного лимита", "REST API (двусторонний)")
Rel(кредитный_модуль, счетный_модуль, "Открытие ссудных счетов", "REST API")
Rel(кредитный_модуль, бухгалтерский_модуль, "Проводки по процентам, штрафам", "REST API")
Rel(кредитный_модуль, лимитный_модуль, "Проверка/установка кредитных лимитов", "REST API")
Rel(кредитный_модуль, тарифный_модуль, "Расчет комиссий по кредитным операциям", "REST API")
Rel(кредитный_модуль, интеграционный_модуль, "Синхронизация кредитных лимитов / Обновление по операциям", "REST API (двусторонний)")
Rel(кредитный_конвейер, кредитный_модуль, "Передача данных о выданном кредите", "REST API")

' === СВЯЗИ ДЕПОЗИТНОГО БЛОКА ===
Rel(депозитный_модуль, счетный_модуль, "Открытие депозитных счетов", "REST API")
Rel(депозитный_модуль, бухгалтерский_модуль, "Проводки по начислению процентов", "REST API")

' === СВЯЗИ МОДУЛЯ ЛИМИТОВ ===
Rel(лимитный_модуль, интеграционный_модуль, "Синхронизация лимитов / Обновление использованных", "REST API (двусторонний)")

' === СВЯЗИ АДМИНИСТРИРОВАНИЯ ===
Rel(админ_модуль, интеграционный_модуль, "Административные запросы", "REST API")

' === СВЯЗИ БУХГАЛТЕРСКОГО МОДУЛЯ ===
Rel(бухгалтерский_модуль, интеграционный_модуль, "Получение транзакций, клиринговых файлов", "REST API")

@enduml