@startuml
!include https://raw.githubusercontent.com/vasilokb/plantUML/refs/heads/main/C4.puml

title Container View – SQL Trainer (с учётом общей аутентификации)

Person(learner, "Обучающийся", "Проходит курсы и решает задачи по SQL.")
Person(methodist, "Методист / Руководитель", "Создаёт и сопровождает учебный контент, анализирует прогресс.")
Person(admin, "Администратор", "Выполняет технические операции, импорт/экспорт задач и данных.")

Boundary(company, "Корпоративный контур") {

  Container(spa, "SQL Trainer UI", "React SPA",    "Веб-интерфейс для обучающихся, методистов и администраторов.     Хранит access_token от Keycloak и шлёт его в backend в Authorization: Bearer."  ) #lightblue

  Container(nginx, "Nginx / API Gateway", "Nginx",    "Точка входа HTTP(S), терминация TLS, маршрутизация REST API-запросов к backend-сервисам."  ) #lightgray

  Boundary(k8s, "Kubernetes Cluster – Backend Services") {

    Container(users_svc, "Users/Auth Service", "Java, Spring Boot",      "Работа с пользователями и ролями в контексте тренажёра:       • хранение профилей пользователей в App DB;       • отображение корпоративных ролей в роли тренажёра (LEARNER/METHODIST/ADMIN);       • REST API /api/me и управление ролями.       Внутри использует общий код AuthFacade/CurrentUser для получения данных из JWT."    ) #lightgreen

    Container(courses_svc, "Courses/Tasks Service", "Java, Spring Boot",      "Управление курсами, модулями и задачами.       Для каждого запроса узнаёт текущего пользователя через AuthFacade/CurrentUser       например, чтобы отдавать только его курсы или проверять права методиста."    ) #lightgreen

    Container(exec_svc, "Execution Service", "Java, Spring Boot",      "Выполнение учебных SQL-запросов над Training DB и возврат результата проверки.       Логирует, кто запустил выполнение userId из CurrentUser, но сам не управляет пользователями."    ) #lightgreen
    Container(progress_svc, "Progress/Reporting Service", "Java, Spring Boot",      "Запись истории попыток, расчёт прогресса и базовая отчётность.       Для каждого запроса использует CurrentUser, чтобы считать и отдавать прогресс       конкретного обучающегося или агрегаты для методиста/админа."    ) #lightgreen
  }

  ContainerDb(app_db, "App DB", "PostgreSQL",    "Сервисные данные: пользователи тренажёра, курсы, задачи,     история попыток, агрегаты прогресса, отчётность."  ) #wheat

  ContainerDb(training_db, "Training DB", "PostgreSQL",    "Учебные схемы и учебные наборы данных для выполнения SQL-запросов."  ) #wheat
}

System_Ext(keycloak, "SSO / Keycloak", "Корпоративная SSO-система OIDC/OAuth2.Выдаёт JWT-токены, которые backend-сервисы используют для построения CurrentUser.")
System_Ext(ad, "Active Directory", "Корпоративный каталог пользователей и групп.")


' Пользователи работают с UI
Rel(learner, spa, "Работает через браузер", "HTTPS")
Rel(methodist, spa, "Работает через браузер", "HTTPS")
Rel(admin, spa, "Работает через браузер", "HTTPS")

' UI ходит к backend через Nginx
Rel(spa, nginx, "REST API-запросы\nс Authorization: Bearer <token>", "HTTPS")
Rel(nginx, users_svc, "Маршрутизация API-запросов", "HTTP(S)")
Rel(nginx, courses_svc, "Маршрутизация API-запросов", "HTTP(S)")
Rel(nginx, exec_svc, "Маршрутизация API-запросов", "HTTP(S)")
Rel(nginx, progress_svc, "Маршрутизация API-запросов", "HTTP(S)")

' Взаимодействия backend-сервисов друг с другом
Rel_R(exec_svc, progress_svc, "Передача результатов проверок\nдля записи истории и пересчёта прогресса", "HTTP(S)")

' Backend <-> DB
Rel(users_svc, app_db, "Чтение/запись данных о пользователях и ролях", "JDBC")
Rel(courses_svc, app_db, "Чтение/запись курсов, модулей и задач", "JDBC")
Rel(progress_svc, app_db, "Чтение/запись истории попыток и агрегатов", "JDBC")

Rel(exec_svc, training_db, "Выполнение учебных SQL-запросов", "JDBC")

' Интеграция с SSO/AD (логин через браузер)
Rel_R(spa, keycloak, "Аутентификация пользователей, редиректы, получение токена", "HTTPS (OIDC)")
Rel_R(keycloak, ad, "Проверка учётных данных, получение атрибутов", "LDAP/LDAPS")

' Backend тоже зависит от Keycloak как от поставщика ключей/JWT-схемы
Rel_R(keycloak, users_svc, "Публикация JWK / схема токена\n(через библиотеки Spring Security)", "HTTPS")
Rel_R(keycloak, courses_svc, "Публикация JWK / схема токена\n(через библиотеки Spring Security)", "HTTPS")
Rel_R(keycloak, progress_svc, "Публикация JWK / схема токена\n(через библиотеки Spring Security)", "HTTPS")
Rel_R(keycloak, exec_svc, "Публикация JWK / схема токена\n(через библиотеки Spring Security)", "HTTPS")

@enduml
