@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Страховая платформа — высокий уровень (только бизнес-подсистемы)

' ==== Персоны ====
Person(indiv,  "Клиент-физлицо",       "Покупает полисы, подает заявления, следит за статусом")
Person(corp,   "Корпоративный клиент", "Корпоративные программы страхования")
Person(agent,  "Агент / брокер",       "Продаёт полисы, ведёт портфель клиентов")
Person(back,   "Сотрудник страховой компании", "Андеррайтинг, сопровождение, урегулирование")
Person(marketer, "Маркетолог / продажник", "Работает с лидами и кампаниями")

System_Ext(landing,   "Сайт / лендинги",              "Формы заявок, калькуляторы, квизы")
System_Ext(social,    "Соцсети, рекламные платформы", "Лид-формы, заявки")
System_Ext(partner_ch,"Партнёрские площадки",         "Банки, агрегаторы, маркетплейсы")

' ==== Платформа страховой компании ====
Enterprise_Boundary(cloud, "Платформа страховой компании") {

  ' --- Канальный слой (все UI схлопнуты) ---
  System(channels_ui, "Канальный слой (все интерфейсы)",    "Клиентский веб/мобайл, портал агентов, рабочие места сотрудников.\n +Единый слой взаимодействия с пользователями и партнёрами")

  ' --- Контур клиентов и спроса ---
  Boundary(customer_contour, "Контур клиентов и спроса") {
    System(crm, "CRM и лиды",      "Сбор и квалификация лидов, кампании, воронка продаж")
    System(customer_master, "Мастер-данные клиентов",      "Карточки физлиц и юрлиц, идентификаторы, контакты, базовый профиль")
  }

  ' --- Страховое ядро (доменные подсистемы) ---
  Boundary(core, "Страховое ядро") {

    System(product_factory, "Фабрика продуктов ",      "Каталог страховых продуктов (ОСАГО, имущество, ДМС, тревел и др.),\n + наборы рисков и покрытий, параметры, тарифы и расчёт премии")

    System(policy_mgmt, "Управление договорами страхования (Полисы)",      "Жизненный цикл договора: создание, изменение, продление, прекращение.\n + Связь с клиентом, продуктом и параметрами риска")

    System(insurance_pipeline, "Страховой конвейер",      "Оркестрация пути от лида до активного полиса:\n + лид → предложение → расчёт → андеррайтинг → выпуск полиса")

    System(uw_svc, "Андеррайтинг и оценка риска",      "Правила принятия/отклонения риска, скоринг, ручные решения, лимиты")

    System(claims_svc, "Урегулирование убытков",      "Заявления, проверка покрытия, рассмотрение, решения, выплаты")

    System(billing_svc, "Биллинг и платежи",      "Премии, рассрочки, счета, учёт оплат и задолженностей")

    System(partner_mgmt, "Управление партнёрами",      "Агенты, брокеры, партнёрские организации и их условия")
  }
}

' ==== Персоны → Канальный слой ====
Rel(indiv,    channels_ui, "Оформление / продление полиса, заявления, статус", "Web / Mobile")
Rel(corp,     channels_ui, "Работа с корпоративными договорами",              "Web")
Rel(agent,    channels_ui, "Продажа и сопровождение полисов",                 "Web")
Rel(back,     channels_ui, "Андеррайтинг, сопровождение, урегулирование",     "Web")
Rel(marketer, channels_ui, "Работа с CRM и лидами",                            "Web")

' ==== Источники лидов → CRM ====
Rel(landing,    crm, "Передача лидов с сайта и калькуляторов", "API/интеграция")
Rel(social,     crm, "Лид-формы и рекламные кампании",          "Интеграции")
Rel(partner_ch, crm, "Лиды из партнёрских каналов",             "API/файлы")

' ==== Канальный слой → контур клиентов и ядро ====
Rel(channels_ui, crm,             "Создание обращений и заявок",     "REST")
Rel(channels_ui, customer_master, "Просмотр/изменение данных клиента","REST")
Rel_D(channels_ui, product_factory, "Запрос доступных продуктов/квот", "REST")
Rel(channels_ui, policy_mgmt,     "Операции по договорам",           "REST")
Rel(channels_ui, claims_svc,      "Подача и просмотр заявлений",     "REST")
Rel(channels_ui, billing_svc,     "Просмотр платежей и задолженностей","REST")

' ==== CRM и мастер-данные ====
Rel(crm, customer_master, "Создание и обновление карточек клиентов", "REST")


' ==== CRM → Страховой конвейер ====
Rel(crm, insurance_pipeline, "Передача квалифицированных лидов в оформление", "REST")

' ==== Страховой конвейер ↔ ядро ====
Rel_R(insurance_pipeline, product_factory, "Выбор продукта и расчёт премии", "REST")
Rel(insurance_pipeline, policy_mgmt,     "Создание/изменение договора",    "REST")
Rel_R(insurance_pipeline, uw_svc,          "Запрос андеррайтинга",           "REST")
Rel_U(insurance_pipeline, billing_svc,     "Запуск биллинга после выпуска",  "REST")

' ==== Связь полисов, клиентов и партнёров ====
Rel(policy_mgmt, customer_master, "Связь договора с клиентом",       "REST")
Rel(policy_mgmt, partner_mgmt,    "Связь договора с агентом/партнёром","REST")

' ==== Убытки ====
Rel(claims_svc, policy_mgmt, "Проверка покрытия по договору", "REST")

@enduml
