@startuml
title ER Диаграмма БД фабрики страховых продуктов
' Автоматически сгенерировано на основе product-factory-class.puml

package "Справочники регуляторов" {
  entity "reg_line_of_business" {
    + id : UUID <<PK>>
    --
    regulator_code : VARCHAR(50)
    name : VARCHAR(255)
    mandatory_or_voluntary : VARCHAR(20)
    regulatory_document : TEXT
  }

  entity "reg_activity_codes" {
    + code : VARCHAR(20) <<PK>>
    --
    description : VARCHAR(255)
  }
}

package "Каталог страховых продуктов" {
  entity "line_of_business" {
    + id : UUID <<PK>>
    --
    internal_code : VARCHAR(50)
    reg_line_of_business_id : UUID <<FK>>
    customer_name : VARCHAR(255)
    sales_channels : JSONB
  }

  entity "product_template" {
    + id : UUID <<PK>>
    --
    product_code : VARCHAR(50)
    commercial_name : VARCHAR(255)
    contractual_name : VARCHAR(255)
    underwriting_class : VARCHAR(50)
    release_form : VARCHAR(50)
    required_documents : JSONB
    line_of_business_id : UUID <<FK>>
    reg_activity_code : VARCHAR(20) <<FK>>
  }

  entity "program_template" {
    + id : UUID <<PK>>
    --
    program_code : VARCHAR(50)
    name : VARCHAR(255)
    coverage_level : VARCHAR(50)
    special_conditions : TEXT
    product_template_id : UUID <<FK>>
  }

  entity "coverage" {
    + id : UUID <<PK>>
    --
    coverage_code : VARCHAR(50)
    name : VARCHAR(255)
    regulator_risk_type : VARCHAR(50)
    coverage_limit : DECIMAL(15,2)
    franchise : DECIMAL(15,2)
    exclusions : TEXT
    regulatory_act : VARCHAR(255)
    program_template_id : UUID <<FK>>
  }
}

package "Тарифная модель" {
  entity "pricing_model" {
    + id : UUID <<PK>>
    --
    model_id : VARCHAR(50)
    model_type : VARCHAR(50)
    regulator_basis : VARCHAR(255)
    effective_from : DATE
    effective_to : DATE
    version : INTEGER
    status : VARCHAR(20)
    program_template_id : UUID <<FK>>
  }

  entity "reg_rate" {
    + id : UUID <<PK>>
    --
    base_rate : DECIMAL(10,4)
    territory_coefficient : DECIMAL(5,2)
    effective_period : DATERANGE
    document_reference : VARCHAR(255)
    pricing_model_id : UUID <<FK>>
  }

  entity "pricing_factor" {
    + id : UUID <<PK>>
    --
    factor_code : VARCHAR(50)
    name : VARCHAR(255)
    value_type : VARCHAR(20)
    data_source : VARCHAR(100)
    mandatory : BOOLEAN
    validation_rules : JSONB
    pricing_model_id : UUID <<FK>>
  }
}

package "Рабочие объекты расчёта" {
  entity "quote_request" {
    + id : UUID <<PK>>
    --
    request_id : VARCHAR(100)
    sales_channel : VARCHAR(50)
    product_template_id : UUID <<FK>>
    program_template_id : UUID <<FK>>
    selected_coverages : JSONB
    factor_values : JSONB
    external_check_results : JSONB
    created_at : TIMESTAMPTZ
  }

  entity "quote_result" {
    + id : UUID <<PK>>
    --
    total_premium : DECIMAL(15,2)
    product_version : VARCHAR(50)
    pricing_model_version : VARCHAR(50)
    coverage_breakdown : JSONB
    factor_breakdown : JSONB
    quote_validity : INTERVAL
    warnings : TEXT[]
    required_documents : TEXT[]
    quote_request_id : UUID <<FK>>
    pricing_model_id : UUID <<FK>>
    calculated_at : TIMESTAMPTZ
  }

  entity "gov_checks" {
    + id : UUID <<PK>>
    --
    vehicle_check : BOOLEAN
    property_check : BOOLEAN
    document_check : BOOLEAN
    history_check : BOOLEAN
    quote_request_id : UUID <<FK>>
  }
}

' Связи многие-ко-многим для выбранных покрытий
entity "quote_request_coverage" {
  + quote_request_id : UUID <<PK, FK>>
  + coverage_id : UUID <<PK, FK>>
  --
  selected : BOOLEAN
  custom_limit : DECIMAL(15,2)
}

' Основные связи
reg_line_of_business ||--o{ line_of_business : "отображается в"
reg_activity_codes ||--o{ product_template : "использует код вида деятельности"
line_of_business ||--o{ product_template : "включает"
product_template ||--o{ program_template : "содержит"
program_template ||--o{ coverage : "состоит из"
program_template ||--o{ pricing_model : "имеет"
pricing_model ||--o{ reg_rate : "включает ставки регулятора"
pricing_model ||--o{ pricing_factor : "использует"
quote_request }o--|| product_template : "ссылается на шаблон"
quote_request }o--|| program_template : "ссылается на программу"
quote_request }o--o{ coverage : "содержит выбор покрытий"
quote_request }o--o{ pricing_factor : "содержит значения факторов"
quote_result }o--|| quote_request : "результат для запроса"
quote_result }o--|| pricing_model : "фиксирует версию тарифа"
gov_checks }o--|| quote_request : "проверки для запроса"

' Связь многие-ко-многим
quote_request ||--o{ quote_request_coverage : "выбранные покрытия"
coverage ||--o{ quote_request_coverage : "входит в запросы"

@enduml