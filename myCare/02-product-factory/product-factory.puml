@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Фабрика продуктов и тарифов — Component View

' ===== Контейнер фабрики =====
Container(product_factory, "Фабрика продуктов и тарифов", "Сервис домена","Единый каталог страховых продуктов, покрытий и тарифных моделей.\nИспользуется для расчёта премий и выдачи продуктовой витрины.")

' ===== Компоненты внутри фабрики =====

Component(prod_query_api, "API каталога продуктов", "REST API","Предоставляет доступ к каталогу: страховые линии, продукты, программы, опции, покрытия.\nИспользуется канальным слоем и модулем управления полисами.")

Component(prod_admin_api, "Админ-API продуктов", "REST API","Создание и изменение продуктов, программ, опций и наборов покрытий.\nИнструмент продуктовой команды и back-office.")

Component(coverage_catalog, "Каталог покрытий и рисков", "Domain Service","Модель покрытий: коды покрытий, лимиты, франшизы, условия применения.\nПереиспользуется разными видами страхования (авто, имущество, тревел, ДМС и др.).")

Component(factor_registry, "Реестр факторов тарификации", "Domain Service","Справочник факторов для расчёта премии: возраст, регион, тип объекта и т.д.\nХранит тип фактора, диапазоны, обязательность и источник данных.")

Component(pricing_model_repo, "Репозиторий тарифных моделей", "Domain Service","Хранение и версионирование тарифных моделей.\nСвязь моделей с продуктами и программами (productCode, programCode).")

Component(pricing_engine, "Движок тарификации", "Domain Service","Расчет страховой премии по запросу котировки.\nИспользует тарифные модели и факторы, возвращает премию и разложение по факторам.")

Component(product_cfg_store, "Хранилище конфигураций продуктов", "DB/Config Store","Персистентное хранение шаблонов продуктов, программ, опций и связей с тарифными моделями.")

' ===== Соседние домены (упрощённо) =====

Container_Boundary(core, "Соседние домены") {

  Container(bff, "Канальный слой / BFF", "Сервис каналов",  "Единое API для фронтов: сайт, мобильное приложение, портал агентов.")

  Container(policy_mgmt, "Управление полисами", "Доменный сервис",  "Создание, изменение, продление и прекращение страховых договоров (полисов).")

  Container(uw_svc, "Андеррайтинг", "Доменный сервис",  "Оценка риска и принятие решения по договору.\nМожет добавлять надбавки к премии.")
}

' ===== Связи внутри фабрики =====

Rel(prod_query_api, product_cfg_store, "Чтение продуктовой витрины", "JDBC/ORM")
Rel(prod_query_api, coverage_catalog, "Чтение доступных покрытий", "Внутренний вызов")

Rel(prod_admin_api, product_cfg_store, "Создание/изменение продуктов и программ", "JDBC/ORM")
Rel(prod_admin_api, coverage_catalog, "Управление покрытиями и рисковыми наборами", "JDBC/ORM")
Rel(prod_admin_api, factor_registry, "Настройка факторов тарификации", "JDBC/ORM")
Rel(prod_admin_api, pricing_model_repo, "Публикация и версияция тарифных моделей", "JDBC/ORM")

Rel(pricing_engine, pricing_model_repo, "Загрузка актуальной тарифной модели", "Внутренний вызов")
Rel(pricing_engine, factor_registry, "Проверка и нормализация факторов", "Внутренний вызов")
Rel(pricing_engine, coverage_catalog, "Проверка покрытий и лимитов", "Внутренний вызов")

Rel(product_cfg_store, coverage_catalog, "Связь продукта с наборами покрытий", "Внутренние ссылки")
Rel(product_cfg_store, pricing_model_repo, "Связь продукта/программы с тарифной моделью", "Внутренние ссылки")

' ===== Внешние взаимодействия фабрики =====

Rel(bff, prod_query_api, "Запрос витрины продуктов и программ", "REST/JSON")
Rel(policy_mgmt, prod_query_api, "Проверка допустимости конфигурации полиса", "REST/JSON")

Rel(policy_mgmt, pricing_engine, "Расчет премии при создании/изменении полиса", "REST/JSON")
Rel(uw_svc,      pricing_engine, "Расчет премии с учётом риск-факторов", "REST/JSON")

@enduml
