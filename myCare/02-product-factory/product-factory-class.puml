@startuml
title Фабрика страховых продуктов и тарифов (Production)

package "Справочники регуляторов" {
  class "Вид страхования по регулятору" as Reg_LineOfBusiness {
    +код регулятора
    +наименование
    +обязательный или добровольный
    +регулирующий документ
  }

  class "Коды вида деятельности страховщика" as Reg_ActivityCodes {
    +код
    +описание
  }
}

package "Каталог страховых продуктов" {
  class "Вид страхования" as LineOfBusiness {
    +внутренний код вида
    +ссылка на код регулятора
    +название для клиента
    +каналы продаж
  }

  class "Шаблон продукта" as ProductTemplate {
    +код продукта
    +название коммерческое
    +название договорное
    +класс андеррайтинга
    +форма выпуска
    +требуемые документы
  }

  class "Программа страхования" as ProgramTemplate {
    +код программы
    +название
    +уровень покрытия
    +спецусловия
  }

  class "Покрытие" as Coverage {
    +код покрытия
    +название
    +тип риска по регулятору
    +лимит покрытия
    +франшиза
    +исключения
    +нормативный акт
  }

  Reg_LineOfBusiness -- LineOfBusiness : отображается в\nвнутренний вид
  LineOfBusiness "1" -- "1..*" ProductTemplate : включает
  ProductTemplate "1" -- "1..*" ProgramTemplate : содержит
  ProgramTemplate "1" -- "1..*" Coverage : состоит из
  ProductTemplate --> Reg_ActivityCodes : использует код\nвида деятельности
}

package "Тарифная модель" {
  class "Тарифная модель" as PricingModel {
    +идентификатор модели
    +тип модели
    +основание по регулятору
    +дата начала действия
    +дата окончания
    +версия
    +статус
  }

  class "Тарифная ставка регулятора" as Reg_Rate {
    +базовая ставка
    +коэффициент территории
    +период действия
    +ссылка на документ
  }

  class "Фактор тарификации" as PricingFactor {
    +код фактора
    +название
    +тип значения
    +источник данных
    +обязательность
    +правила проверки
  }

  PricingModel "1" -- "0..*" Reg_Rate : включает ставки\nрегулятора
  PricingModel "1" -- "1..*" PricingFactor : использует
  ProgramTemplate "1" -- "1..*" PricingModel : имеет
}

package "Рабочие объекты расчёта" {
  class "Запрос расчёта" as QuoteRequest {
    +идентификатор запроса
    +канал продаж
    +код продукта
    +код программы
    +выбранные покрытия
    +значения факторов
    +результаты внешних проверок
  }

  class "Результат расчёта" as QuoteResult {
    +итоговая премия
    +версия продукта
    +версия тарифной модели
    +разбивка по покрытиям
    +разбивка по факторам
    +срок действия котировки
    +предупреждения
    +документы для оформления
  }

  QuoteRequest --> ProductTemplate : ссылается\nна шаблон
  QuoteRequest --> ProgramTemplate : ссылается\nна программу
  QuoteRequest --> Coverage : содержит выбор\nпокрытий
  QuoteRequest --> PricingFactor : содержит значения\nфакторов
  QuoteResult --> PricingModel : фиксирует версию\nтарифа
}

package "Внешние проверки и источники" {
  class "Проверки по госреестрам" as GovChecks {
    +проверка данных ТС
    +проверка имущества
    +проверка документов
    +проверка истории
  }
}

package "Сервисы фабрики" {
  class "Фабрика продуктов" as ProductFactory {
    +подобрать доступные продукты
    +проверить применимость продукта
    +собрать запрос расчёта
    +выдать требования по документам
  }

  class "Правила выбора тарифа" as PricingRules {
    +подобрать тарифную модель
    +проверить ограничения по региону и каналу
    +проверить право на вид страхования
  }

  class "Сервис расчёта премии" as PricingService {
    +проверить запрос
    +рассчитать премию
    +сохранить историю расчётов
  }

  class "Андеррайтинг" as UnderwritingEngine {
    +автопроверка риска
    +класс риска
    +требование доп. документов
  }

  ProductFactory --> LineOfBusiness
  ProductFactory --> ProductTemplate
  ProductFactory --> ProgramTemplate
  ProductFactory --> Coverage
  ProductFactory --> QuoteRequest : формирует

  PricingService --> QuoteRequest : принимает
  PricingService --> PricingRules : запрашивает\nвыбор тарифа
  PricingRules --> PricingModel : выбирает
  PricingService --> PricingModel : применяет
  PricingService --> QuoteResult : возвращает

  QuoteRequest --> GovChecks : запрашивает\nпроверки
  UnderwritingEngine --> GovChecks : использует\nпроверки
  PricingService --> UnderwritingEngine : передаёт на\nпроверку риска
}

@enduml
