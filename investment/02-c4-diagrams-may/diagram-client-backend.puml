@startuml C4
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' =================================
' НАСТРОЙКИ КОМПОНОВКИ
' =================================
left to right direction       
' Горизонтальное расположение основных блоков
skinparam linetype ortho      
' Прямоугольные линии связей
skinparam nodesep 60          
' Горизонтальное расстояние между узлами
skinparam ranksep 60          
' Вертикальное расстояние между рангами

' =================================
' БАЗЫ ДАННЫХ И ИНФРАСТРУКТУРА (вынесены ближе к своим потребителям)
' =================================
ContainerDb(postgres1, "PostgreSQL 14/15/17", "Database", "Backend Admin DB")
ContainerDb(postgres2, "PostgreSQL 14/15/17", "Database", "Backend Client DB")
ContainerDb(redis1, "Redis 7.2", "Cache", "Redis for accounts, assets, orders")
ContainerDb(redis2, "Redis 7.2", "Cache", "Redis for OTP, notifications")
System(Node3_redis, "Redis Cluster", "Кластер Redis для кэша")
System(Node3_kafka, "Kafka 7.0.0/7.9.0", "Message broker", "Kafka для событийного взаимодействия")
System(Node3_zookeeper, "Zookeeper 6.2.2/7.9.0", "Координатор", "Для Kafka")
System(Node3_minio, "MinIO", "Object Storage", "Хранение документов и PDF")
System(Node3_postgres_containers, "PostgreSQL Containers", "Node 3 DB", "Инстансы PostgreSQL на Node 3")
System(Node2_postgres_containers, "PostgreSQL Containers", "Node 2 DB", "Инстансы PostgreSQL на Node 2")
System(Node2_keycloak, "Keycloak", "IdP", "Ключевой авторизационный сервер")
System(Node2_zipkin, "Zipkin", "Трэсинг", "Distributed tracing service")
System(Node2_prometheus, "Prometheus", "Метрики", "Сбор метрик микросервисов")
System(Node2_alertmanager, "Alertmanager", "Алерты", "Оповещения по метрикам")
System(Node2_grafana, "Grafana", "Визуализация", "Дашборды метрик")

' =================================
' ПОЛЬЗОВАТЕЛИ
' =================================
Person(customer, "Клиент (инвестор)", "Конечный пользователь инвестиционного сервиса")
Person(employee, "Сотрудник", "Администратор, биржевой сотрудник")

' =================================
' ФРОНТЕНД
' =================================
Boundary(frontend, "Frontend Layer") {
  Container(react_frontend, "React Frontend", "Vite 4.4.9", "SPA клиентского приложения")
  Container(react_backend, "React Build Env", "Docker (node:20-alpine)", "Сборка фронтенда")
}

' =================================
' CLIENT BACKEND (группируем с его БД и Redis)
' =================================
Boundary(client_backend, "Client Backend (client/backend/)") {
  together {
    Container(account_client, "account-service", "Spring Boot 3.5.0", "Клиентские брокерские счета")
    Container(customer_client, "customer-service", "Spring Boot 3.5.0", "Клиенты (инвесторы, регистрация, профиль)")
    Container(catalog_client, "catalog-service", "Spring Boot 3.5.0", "Каталог финансовых инструментов")
    Container(document_client, "document-service", "Spring Boot 3.5.0", "Клиентские документы, PDF, 2-NDFL")
    Container(emulator_client, "emulator-service", "Kotlin + Java", "Эмулятор биржи MOEX, ордера, котировки")
    Container(notification_client, "notification-service", "Spring Boot 3.5.0", "Push/SSE/Email уведомления для клиентов")
    Container(otp_client, "otp-service", "Spring Boot 3.5.0", "OTP коды для критичных операций")
  }
}

' =================================
' ADMIN BACKEND (группируем с его БД и Redis)
' =================================
Boundary(admin_backend, "Admin Backend (backend/)") {
  together {
    Container(auth_admin, "auth-service", "Spring Boot 3.5.5", "Аутентификация и авторизация (JWT, кастомный auth)")
    Container(trading_admin, "trading-service", "Spring Boot 3.5.0", "Обработка ордеров, портфели, комиссии")
    Container(education_admin, "education-service", "Spring Boot 3.5.0", "Образовательный контент (курсы, уроки)")
    Container(employee_admin, "employee-service", "Spring Boot 3.5.0", "Данные о сотрудниках")
    Container(userinfo_admin, "userinfo-service", "Spring Boot 3.5.0", "Информация о пользователях, WebSocket")
    Container(management_admin, "management-service-pb", "Spring Boot 3.5.0", "Управление, партнёрские кампании")
    Container(document_admin, "document-service-pb", "Spring Boot 3.5.0", "Документы для партнёрского банка")
    Container(account_admin, "account-service-test", "Spring Boot 3.5.0", "Тест/альтернативный сервис счетов")
    Container(tax_admin, "tax-service", "Spring Boot 3.5.0", "Налоговые расчёты (2-NDFL)")
    Container(support_admin, "support-service", "Spring Boot 3.5.6", "Поддержка клиентов")
    Container(financial_admin, "financialtransactions-service", "Spring Boot 3.5.0", "Финансовые транзакции")
    Container(customercare_admin, "customercare-service", "Spring Boot 3.5.0", "Клиентский сервис, дублёр support-service")
    Container(newsfeed_admin, "newsfeed-service", "Spring Boot 3.5.0", "Лента новостей")
    Container(feedback_admin, "criticalfeedbackchannel", "Spring Boot 3.5.0", "Канал критических жалоб")
    Container(test_admin, "test-service", "Spring Boot 3.5.0", "Тестовый сервис")
    Container(gateway_admin, "api-gateway", "Spring Boot 3.5.0", "API Gateway (SCG WebFlux + Feign + CircuitBreaker + Zipkin + Prometheus)")
  }
}

' =================================
' СБОРКА (JAR, NEXUS, QA)
' =================================
Boundary(backend_builders, "Backend Build Env") {
  Container(backend_builder1, "Gradle Builder 1", "Gradle 9.0.0-jdk17-alpine", "Сборка Java-микросервисов")
  Container(backend_builder2, "Gradle Builder 2", "Gradle 9.0.0-jdk17-alpine", "Сборка Java-микросервисов")
}
Boundary(shared_libs, "Shared Libraries (Nexus)") {
  Container(nexus_registry, "Nexus Registry", "Maven/Jar Registry", "Хранение общих библиотек: DTO, shared starters")
}
Boundary(qa_layer, "QA / AQA Layer") {
  together {
    Container(aqa_api, "AQA API tests", "Java 17, JUnit 5, REST Assured", "Тестирование API сервисов")
    Container(aqa_ui, "AQA UI tests", "Java 17, Selenium WebDriver", "UI тестирование инвестиционного приложения")
    Container(allure_reports, "Allure Reports", "Test reports", "Отчеты по результатам тестов")
    Container(wiremock_stubs, "WireMock Stubs", "Сервисы-заглушки", "Mock-сервисы для тестирования")
  }
}

' =================================
' ИНФРАСТРУКТУРА (узлы)
' =================================
System_Boundary(infra, "Инфраструктура (Kubernetes Nodes)") {
  System(node3, "Kubernetes Node 3 (Release)", "Node 3 - Release/Prod env", "172.17.1.26:31531")
  System(node2, "Kubernetes Node 2 (Dev)", "Node 2 - Dev env")
  System(node1, "Kubernetes Node 1 (CI/CD)", "Node 1 - CI/CD")
}

