@startuml
title Предварительная архитектура MVP

top to bottom direction

skinparam shadowing false
skinparam linetype ortho
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam ArrowColor #455A64
skinparam defaultTextAlignment center
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B38B00

actor "Увольняемый сотрудник\nРФ / РБ" as User
actor "Карьерный консультант" as Consultant

package "Публичный контур" #41ABE0 {
    component "Веб-шлюз /\nобратный прокси/nginx и тд\n\nHTTPS, маршрутизация,\nограничение частоты запросов\n\nКонкретное решение\nне выбрано" as Gateway

    component "Адаптивный веб-интерфейс\n\nЛичный кабинет пользователя\nКабинет консультанта" as Web
}

package "Закрытый контур приложения" #52F280 {

    package "Backend — модульный монолит" #F1F8E9 {
        component "API / оркестрация\nпользовательских сценариев" as API

        component "Авторизация и доступ\n\nЛогин и пароль\nРоли USER / CAREER_CONSULTANT\nСрок доступа и блокировка" as Access

        component "Профиль и резюме\n\nСтрана РФ / РБ\nТип ЛАБ / ПП\nСпециализация\nВерсии резюме" as Profile

        component "Извлечение данных резюме\n\nПолучение текста\nМаскирование идентификаторов\nИзвлечение hard skills" as ResumeProcessing

        component "Справочник специализаций\nи профессиональных навыков\n\nКанонические названия\nАлиасы\nСтоп-лист soft skills" as Taxonomy

        component "Каталог вакансий\n\nНормализация полей\nДедупликация\nАктуальность вакансий" as Vacancies

        component "Адаптер источника\nвакансий" as VacancyAdapter

        component "Адаптер LLM\n\nМинимизация payload\nСтруктурированный ответ\nTimeout / ограниченный retry" as LLMAdapter

        component "Подбор вакансий\n\nФильтрация\nРасчёт соответствия\nСортировка и объяснение" as Matching

        component "Аналитика и отчётность\n\nСобытия использования\nИсторические срезы\nАгрегированные отчёты" as Analytics

        component "Управление хранением\n\nОкончание доступа\nSoft-delete\nHard-delete / обезличивание" as Retention

        component "Фоновые задания\n\nОбработка резюме\nОбновление вакансий\nУдаление и агрегация\n\nВыделение в отдельный процесс —\nпосле замеров" as Jobs
    }

    database "PostgreSQL\n\nПредлагается; требуется\nсогласование архитектора\n\nУчётные записи и доступ\nПрофили и извлечённые навыки\nСправочники и вакансии\nПоиски и результаты\nСобытия и аудит\nРасписание удаления" as DB #EAf252

    storage "Временное хранилище\nисходных резюме\n\nНужно решить:\nхранить ли файл и как долго" as ResumeStorage #FFF3E0

    component "Хранилище секретов\n\nКлючи интеграций\nПароли сервисов" as Secrets

    component "Мониторинг и журналирование\n\nТехнические метрики\nОшибки и аудит\nБез текста резюме и паролей" as Monitoring
}

package "Внешние системы и открытые интеграции" #EAF252 {
    component "Источник вакансий\n\nCERBER\n\nНужно покрытие РФ, РБ\nи 18 направлений" as VacancySource

    component "Сервис языковой модели\n\nПровайдер и модель\nне выбраны\n\nПередача данных требует\nюридических обсуждений или готового решени" as LLM

    component "Сервис уведомлений\n\nОпционально\n2FA не требуется\nСпособ передачи и восстановления\nдоступа пока не определён" as Notification #52F2E2
}

' Вход пользователей
User --> Gateway : HTTPS\nВход, резюме, поиск
Consultant --> Gateway : HTTPS\nПользователи, доступ, аналитика

Gateway --> Web : Веб-интерфейс
Gateway --> API : API-запросы\nпо тому же публичному входу
Web ..> API : REST / JSON\nчерез Gateway

' Модули приложения
API --> Access : Авторизация и проверка доступа
API --> Profile : Профиль и резюме
API --> Matching : Поиск и результаты
API --> Analytics : Серверные бизнес-события

Access --> DB : Учётные записи, роли,\nсроки и история доступа
Profile --> DB : Профиль, страна, ЛАБ / ПП,\nверсии и навыки
Taxonomy --> DB : Специализации, навыки,\nстоп-лист
Vacancies --> DB : Нормализованные вакансии
Matching --> DB : Задания, результаты,\nверсия алгоритма
Analytics --> DB : События и агрегаты
Retention --> DB : Статусы и удаление данных

' Обработка резюме и мэтчинг
Profile --> ResumeStorage : Исходный файл\nтолько если хранение согласовано
Profile --> Jobs : Поставить резюме\nна обработку
Jobs --> ResumeProcessing : Извлечь профиль
ResumeProcessing --> Taxonomy : Нормализовать навыки
ResumeProcessing --> LLMAdapter : Только разрешённые данные 
LLMAdapter --> LLM : HTTPS / JSON
LLM --> LLMAdapter : Структурированные навыки
ResumeProcessing --> DB : Сохранить извлечённый\nпрофессиональный профиль

Matching --> Profile : Скиллы юзера
Matching --> Taxonomy : Канонические навыки
Matching --> Vacancies : Кандидаты на подбор

' Получение вакансий
Jobs --> Vacancies : Обновить каталог
Vacancies --> VacancyAdapter : Запрос / синхронизация
VacancyAdapter --> VacancySource : HTTPS / JSON
VacancySource --> VacancyAdapter : Вакансии
Vacancies --> LLMAdapter : Извлечь hard skills,\nесли данных источника недостаточно

' Аналитика, хранение и эксплуатация
Jobs --> Retention : Проверить сроки\nи выполнить удаление
Jobs --> Analytics : Рассчитать агрегаты

API --> Monitoring : Запросы, события и ошибки
Jobs --> Monitoring : Задания и ошибки
API --> Secrets : Настройки интеграций
Jobs --> Secrets : Настройки интеграций

' Уведомления не являются подтверждённой частью MVP
Access ..> Notification : Приглашение / восстановление\nтолько если будет согласовано
Notification ..> User : Канал пока не выбран

note right of Access
  Подтверждено PO:
  - VPN не требуется;
  - 2FA не требуется;
  - доступ создаёт и продлевает консультант;
  - пользователи из РФ и РБ.

  Публичны только Web / API.
  БД и хранилища остаются закрытыми.
end note

note right of Profile
  Обязательные бизнес атрибуты:
  - страна: РФ или РБ;
  - тип сотрудника: ЛАБ или ПП;
  - профессиональное направление;
  - срок действия доступа.

  Страна и ЛАБ / ПП используются
  для управления и аналитики,
  но не участвуют в score.
end note

note right of Matching
  Подтверждено PO:
  - анализ key skills, опыта и О СЕБЕ;
  - используются технологии и инструменты;
  - общие soft skills исключаются;
  - опыт, локация, формат работы,
    наличие зарплаты, направление и дата — фильтры.

  Предложение для MVP:
  - LLM извлекает и нормализует навыки или они уже будут нормализованы? в каком формате будут данные?;
  - процент рассчитывается детерминированно;
  - пользователю объясняются совпадения.

  Формула, веса, порог
  требуют согласования PO на примере.
end note

note right of Analytics
  Требуемые разрезы:
  - период;
  - страна;
  - ЛАБ / ПП;
  - профессиональное направление;
  - диапазон опыта.

  События фиксируются сервером:
  создание пользователя, вход, сессия,
  обработка резюме, поиск, выгрузка,
  переход по вакансии, продление
  и удаление.

  Определения «повторный пользователь»,
  «посещение» и «выгрузка» ещё
  требуется формализовать.
end note

note right of Retention
  Подтверждено PO:
  - soft-delete через 3 месяца;
  - hard-delete через 6 месяцев.

  Открытые решения:
  - от какой даты считать сроки?
  - как продление сдвигает удаление?
  - что удаляется из файлов, логов и бэкапов?
  - как сохранить многолетние агрегаты
    без возможности идентифицировать пользователя?
end note

note right of LLMAdapter
  Открытые решения:
  - провайдер и модель?
  - разрешённые части резюме?
  - маскирование идентификаторов?
  - timeout, retry и лимиты?

  Автоматический фоллбэк на другой LLM
  не подтвержден, решили показывпть
  модалку В данный момент система недоступна;
end note

note bottom of VacancySource
  До реализации требуется Vacancy Source Contract:
  доступ, авторизация, схема полей,
  пагинация, квоты, обновление, ошибки,
  тестовый контур, покрытие направлений,
  локаций РФ и РБ.
end note

note bottom of ResumeStorage
  Рекомендуется хранить исходный файл
  только если он нужен бизнес-процессу.

  Для мэтчинга достаточно сохранить
  структурированный профиль и версии.

  Решение требует подтверждения
  PO, архитектора и возможно юриста
end note

legend top
|= <#Gray> Цвет |= <#Gray> Статус |
|<#52F280> Зелёный | <#52F280> Подтверждённый бизнес-контур MVP |
|<#41ABE0> Синий | <#41ABE0> Публичная точка входа |
|<#EAF252> Жёлтый | <#EAF252> Предложение или открытое архитектурное решение |
|<#52F2E2> Бирюзовый | <#52F2E2> Опционально, не подтверждено для MVP |
|= <#Gray> Термин на диаграмме |= <#Gray> Обозначение |
|<#FFFFFF> ПП | <#FFFFFF> Производственный персонал |
|<#FFFFFF> ЛАБ | <#FFFFFF> Лаборант |
|<#FFFFFF> CERBER | <#FFFFFF> Проектное название источника вакансий с hh |
|<#FFFFFF> Адаптер | <#FFFFFF> Прослойка кода (класс или модуль), которая изолирует систему\n от прямого взаимодействия с API другой системы. |
|<#FFFFFF> Адаптер | <#FFFFFF> Процесс поиска соответствий, связывания или сопоставления двух и\n более сущностей по определенным правилам, алгоритмам, критериям |
|<#FFFFFF> Нормализация | <#FFFFFF> Приведение данных к единому формату для корректнго сравнения, поиска или мэтчинга |
endlegend

@enduml


